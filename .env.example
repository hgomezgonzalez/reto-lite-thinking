# ==========================================================================
# Variables de entorno del backend (copiar a backend/.env o exportarlas).
# ==========================================================================

# --- Base de datos PostgreSQL ---
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/reto_db
JDBC_DATABASE_USERNAME=reto_user
JDBC_DATABASE_PASSWORD=reto_pass
# Esquema donde se crean las tablas (en Heroku: reto_lite sobre la BD compartida)
DB_SCHEMA=reto_lite

# --- Seguridad JWT ---
# Clave en base64 de al menos 256 bits. CAMBIAR en produccion.
JWT_SECRET=Y2hhbmdlLW1lLXRoaXMtaXMtYS1kZW1vLXNlY3JldC1rZXktMjU2LWJpdHMtbG9uZw==
JWT_EXPIRATION_MS=86400000

# --- Correo SMTP (envio del PDF de inventario) ---
# Local (MailHog): host=localhost puerto=1025 sin auth ni TLS.
# Produccion (Gmail): host=smtp.gmail.com puerto=587 auth=true tls=true + App Password.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
SMTP_FROM=no-reply@litethinking.local

# --- CORS (origenes del frontend permitidos) ---
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://localhost:8081

# --- Conversion de monedas ---
CURRENCY_BASE=COP
CURRENCY_TARGETS=COP,USD,EUR
CURRENCY_API_URL=https://open.er-api.com/v6/latest
